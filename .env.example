# Optional access token required by POST /api/v1/answer.
# Leave empty for local-only development; set a private value before sharing the service.
OCS_LLM_ANSWERER_API_KEY=

# SQLite cache and request log database path.
OCS_LLM_ANSWERER_DATABASE_PATH=data/cache.sqlite3

# Local provider runtime config. Copy config/providers.example.json to this path.
OCS_LLM_ANSWERER_PROVIDERS_CONFIG_PATH=config/providers.json

# OCS request mode in /ocs-answerer.json: fetch or GM_xmlhttpRequest.
OCS_LLM_ANSWERER_OCS_ANSWERER_REQUEST_TYPE=fetch

# Provider API keys. The providers.json api_key_env field can point to any name here.
OPENAI_API_KEY=
# CUSTOM_LLM_API_KEY=
